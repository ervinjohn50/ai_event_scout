# Copy this file to .env and fill in your keys. .env is git-ignored.
# The CLI loads .env automatically on startup.

# Required: your Claude API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: Ticketmaster Discovery API key (free at https://developer.ticketmaster.com).
# Leave empty to use the bundled offline sample events.
TICKETMASTER_API_KEY=

# Optional: LangSmith tracing (free key at https://smith.langchain.com).
# When on, prompts, tool results, and answers are sent to LangSmith's servers.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
#
# Then set a destination, using the settings LangSmith shows for your workspace.
# Use one of these, not both. LangSmith doesn't trace calls when both are set.
# Agent-based workspaces:
# LANGSMITH_AGENT_ID=event-scout
# LANGSMITH_AGENT_ENVIRONMENT=local
# Project-based workspaces (the default if neither is set):
# LANGSMITH_PROJECT=event-scout
