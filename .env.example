# Copy this file to .env and fill in your keys. .env is git-ignored.
# The CLI loads .env automatically on startup.

# Required: your Claude API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: Ticketmaster Discovery API key (free at https://developer.ticketmaster.com).
# Leave empty to use the bundled offline sample events.
TICKETMASTER_API_KEY=
